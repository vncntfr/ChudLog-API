{
  "name": "@chudlog/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ChudLog REST API \u2014 Node 22 + Hono + better-sqlite3",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "vapid:gen": "tsx src/vapid-keygen.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "backup": "tsx src/backup-cli.ts",
    "reset:issue": "tsx src/reset-cli.ts"
  },
  "dependencies": {
    "@chudlog/shared": "*",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.8.0",
    "tsx": "^4.19.0",
    "web-push": "^3.6.4",
    "zod": "^3.25.0",
    "@hono/node-server": "^1.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  }
}
