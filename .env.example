NODE_ENV=production
HOST=0.0.0.0
PORT=8787
DB_PATH=/data/chudlog.db

PUBLIC_ORIGIN=https://chudlog.xyz
ALLOWED_ORIGINS=
SITE_ADDRESS=chudlog.xyz

SESSION_SECRET=GENERATE_WITH_NPM_RUN_ENV_PRODUCTION
VAPID_PUBLIC_KEY=GENERATE_WITH_NPM_RUN_ENV_PRODUCTION
VAPID_PRIVATE_KEY=GENERATE_WITH_NPM_RUN_ENV_PRODUCTION
VAPID_ADMIN_EMAIL=admin@chudlog.xyz
VAPID_SUB=mailto:admin@chudlog.xyz
ADMIN_EMAILS=

BACKUP_DIRECTORY=/backups
BACKUP_ENCRYPTION_KEY=GENERATE_WITH_NPM_RUN_ENV_PRODUCTION
# On a server, point this at a mounted remote/off-host filesystem.
BACKUP_HOST_PATH=./backups
